{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/ghoul/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "feedbackDrafts": "notify",
  "syntaxHighlightingDisabled": false,
  "timeFormat": "24-hour",
  "theme": "custom:omarchy",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoContinueAtUsageLimit": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
