{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "grouping": "auto",
    "new_location": "inherit",
    "permissions": "prompt"
  },
  "animations": true,
  "prompt": {
    "image_preview": true
  },
  "tabs": {
    "indicators": "numbers"
  },
  "plugins": ["./herdr-opencode"]
}
