new file mode 100644
index 0000000..240719c
--- /dev/null
+++ b/src/shared/limits/exhaustedQuota.js
@@ -0,0 +1,18 @@
+'use strict';
+
+const { LIMITS_RESET_BOUNDARY_DELAY_MS } = require('./resetBoundary');
+
+function exhaustedUntil(row, now) {
+  if (row?.status !== 'ok') return null;
+  const exhausted = (row.windows || []).filter(window =>
+    ['session', 'daily', 'weekly', 'monthly', 'billing'].includes(window.kind) &&
+    !window.additional && !window.metric && window.showMeter !== false &&
+    (window.remainingPercent ?? (100 - window.usedPercent)) === 0);
+  if (!exhausted.length) return null;
+  const resets = exhausted.map(window => Date.parse(window.resetsAt || ''));
+  if (!resets.every(Number.isFinite)) return null;
+  const until = Math.max(...resets) + LIMITS_RESET_BOUNDARY_DELAY_MS;
+  return until > now ? until : null;
+}
+
+module.exports = { exhaustedUntil };
