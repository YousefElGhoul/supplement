+      const oauth = credentials?.claudeAiOauth || {};
+      const account = oauth.accountUuid || oauth.organizationUuid;
+      if (account) return `account:${account}${oauth.accountUuid && oauth.organizationUuid ? `:${oauth.organizationUuid}` : ''}`;
+    } else if (provider === 'codex') {
+      const account = credentials?.tokens?.account_id || credentials?.account_id;
+      if (account) return `account:${account}`;
+    }
+    try {
+      const stat = fs.statSync(scopes[provider]);
+      return `file:${stat.dev}:${stat.ino}:${stat.mtimeMs}:${stat.size}`;
+    } catch {
+      return null;
+    }
