+        good,
+        status: limited ? 'sourceRateLimited' : prior?.status || 'unavailable',
+        failures: limited ? (prior?.failures || 0) + 1 : prior?.failures || 0,
+        cooldownUntil: limited ? until : 0,
+        lastAttemptAt: current,
+        nextAt: until
+      });
+      throw error;
+    }
