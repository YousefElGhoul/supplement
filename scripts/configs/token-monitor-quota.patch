+'use strict';
+
+const fs = require('node:fs');
+const { exhaustedUntil } = require('../shared/limits/exhaustedQuota');
+
+// A panel open or a refresh click may ask sooner than the scheduled poll, but
+// never more often than this. The window is short enough to feel live and long
+// enough to absorb repeated clicks.
+const INTERACTIVE_REUSE_MS = 15_000;
+const INTERACTIVE_REASONS = new Set(['manual-refresh', 'panel-open']);
+const SCHEDULED_INTERVAL_MS = { claude: 900_000, codex: 120_000 };
