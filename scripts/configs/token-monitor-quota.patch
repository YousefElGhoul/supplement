+    const creditCheckAt = provider === 'codex' ? Math.min(...published
+      .filter(row => exhaustedUntil(row, current) && row.resetCredits?.availableCount > 0)
+      .map(row => (row.headlessCreditsCheckedAt ?? current) + interval)) : Infinity;
+    const nextAt = limited ? now() + delay : Math.min(current + interval, creditCheckAt);
+    if (limited) context?.onRetryAfter?.(delay);
+    save({
+      identity,
+      rows: published,
+      good: published.some((row) => row.status === 'ok')
+        ? published.filter((row) => row.status === 'ok') : good,
+      status,
+      failures,
+      cooldownUntil: limited ? nextAt : 0,
+      lastAttemptAt: current,
+      completedAt: now(),
+      nextAt
+    });
+    console.log(`[quota] ${provider} ${published.map((row) => row.status).join(',')}; next check no earlier than ${new Date(state[provider].nextAt).toISOString()}`);
+    return published;
+  };
+
+  gate.previousLimits = { providers: Object.keys(scopes).flatMap((provider) => {
+    const entry = state[provider];
+    if (!entry || entry.identity !== identityFor(provider)) return [];
+    return entry.rows?.length ? entry.rows : entry.good || [];
+  }) };
+  return gate;
+}
+
+module.exports = { quotaProbe, quotaRefreshPriority };
