+    const limited = rateLimited || retryAfter > 0 || result.some((row) => ['sourceRateLimited', 'rateLimited'].includes(row.status));
+    if (context?.signal?.aborted && !limited) return result;
+    const failures = limited ? (prior?.failures || 0) + 1 : 0;
+    const delay = limited
+      ? (retryAfter > 0
+          ? Math.max(INTERACTIVE_REUSE_MS, retryAfter)
+          : Math.min(MAX_COOLDOWN_MS, interval * 2 ** Math.min(failures - 1, 2)))
+        + Math.floor(random() * 5000)
+      : interval;
+    const published = result.map((row) => {
+      const old = good.find((entry) => entry.accountKey === row.accountKey) ||
+        (!row.accountKey && good.length === 1 ? good[0] : null);
+      return ['sourceRateLimited', 'rateLimited', 'unavailable', 'timeout', 'error'].includes(row.status) && !row.windows?.length && old
+        ? { ...old, status: row.status, stale: true } : row;
+    });
