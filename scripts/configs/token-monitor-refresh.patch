diff --git a/src/agent/refreshServer.js b/src/agent/refreshServer.js
new file mode 100644
index 00000000..873512b7
--- /dev/null
+++ b/src/agent/refreshServer.js
@@ -0,0 +1,56 @@
+'use strict';
+
+const fs = require('node:fs');
+const net = require('node:net');
+const path = require('node:path');
+
+function refreshSocketPath(env = process.env) {
+  const runtimeDir = env.XDG_RUNTIME_DIR || `/run/user/${process.getuid()}`;
+  return path.join(runtimeDir, 'token-monitor-refresh.sock');
+}
+
+function createRefreshServer(refresh, socketPath = refreshSocketPath()) {
+  let activeRefresh = null;
+  const server = net.createServer((socket) => {
+    socket.setEncoding('utf8');
+    let input = '';
+    let handled = false;
+    socket.on('data', (chunk) => {
+      if (handled) return;
+      input += chunk;
+      if (input.length > 256) {
+        handled = true;
+        socket.end('{"ok":false,"error":"request too large"}\n');
+        return;
+      }
+      const newline = input.indexOf('\n');
+      if (newline < 0) return;
+      let request;
+      try {
+        request = JSON.parse(input.slice(0, newline));
+      } catch {
+        handled = true;
+        socket.end('{"ok":false,"error":"invalid request"}\n');
+        return;
+      }
+      if (request?.command !== 'refresh') {
+        handled = true;
+        socket.end('{"ok":false,"error":"unknown command"}\n');
+        return;
+      }
+      handled = true;
+      activeRefresh ||= Promise.resolve().then(refresh).finally(() => { activeRefresh = null; });
+      activeRefresh.then(
+        () => socket.end('{"ok":true}\n'),
+        () => socket.end('{"ok":false,"error":"refresh failed"}\n')
+      );
+    });
+  });
+
+  fs.mkdirSync(path.dirname(socketPath), { recursive: true, mode: 0o700 });
+  try { fs.unlinkSync(socketPath); } catch (error) { if (error.code !== 'ENOENT') throw error; }
+  server.listen(socketPath, () => fs.chmodSync(socketPath, 0o600));
+  server.on('close', () => { try { fs.unlinkSync(socketPath); } catch (_) {} });
+  return server;
+}
+module.exports = { createRefreshServer, refreshSocketPath };
